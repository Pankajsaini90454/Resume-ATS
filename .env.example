# ====================================================
# Resumely ATS Configuration
# ====================================================

# Port for the server (defaults to 4000 locally, set automatically by Render)
PORT=4000

# Node environment: 'development' or 'production'
NODE_ENV=production

# MongoDB Connection String (e.g. from MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resumely?retryWrites=true&w=majority
MONGO_DATABASE=resumely

# JWT Secret for user session tokens (required in production)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini API Key (get free from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# Gemini model (defaults to gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-3.5-flash

# Optional: Allowed CORS client origins (comma-separated, leave blank to allow same-origin & Render)
CLIENT_ORIGIN=

# Optional: Cloudinary configuration for storing uploaded resume files
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
